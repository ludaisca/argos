# ── LLM (cualquier API compatible con OpenAI) ─────────────────────────
ARGOS_LLM_API_KEY=sk-...
# Ejemplos de base_url por proveedor:
#   OpenAI     https://api.openai.com/v1
#   DeepSeek   https://api.deepseek.com/v1
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Ollama     http://host.docker.internal:11434/v1   (local, sin key real)
ARGOS_LLM_BASE_URL=https://api.openai.com/v1
ARGOS_LLM_MODEL=gpt-4o-mini

# ── Objetivo de investigación ─────────────────────────────────────────
# Ruta dentro del contenedor (el compose monta ./brief.yaml acá):
ARGOS_BRIEF_FILE=/app/brief.yaml
# …o texto libre, sin archivo:
# ARGOS_BRIEF="Investigar cómo se habla de DeepSeek en Instagram y Facebook"

# ── Cadencia y avisos ─────────────────────────────────────────────────
ARGOS_INTERVAL_HOURS=12
# Webhook opcional (n8n, Slack, Make…): recibe {"text": "...", "analysis": "..."}
# ARGOS_WEBHOOK_URL=

# ── Credenciales (opcional si montás ./cookies) ───────────────────────
# Exportalas en tu máquina:  argos cookies instagram --out ig.json
#                            argos cookies facebook  --out fb.json
# y pegá el contenido en una línea (o usá ARGOS_COOKIES_DIR=/cookies):
# ARGOS_COOKIES_IG=[{"name":"sessionid","value":"...","domain":".instagram.com","path":"/"}]
# ARGOS_COOKIES_FB=[{"name":"c_user","value":"...","domain":".facebook.com","path":"/"}]
